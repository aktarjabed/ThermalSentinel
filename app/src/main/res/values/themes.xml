<resources>

    <!--
      Post-splash theme. Parent is a DayNight framework theme; the action bar
      is disabled manually because Theme.DeviceDefault.DayNight.NoActionBar
      does not exist in the framework.
    -->
    <style name="Theme.ThermalSentinel" parent="android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!--
      Launch theme. core-splashscreen holds this on screen until the
      appearance preferences have loaded from DataStore, so the first Compose
      frame is already the correct light/dark theme.
    -->
    <style name="Theme.ThermalSentinel.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.ThermalSentinel</item>
    </style>

</resources>
